# Replace with a long random secret before deploying.
APP_ENV=development
RESUMEIQ_SECRET_KEY=replace-this-with-a-long-random-secret
# SQLite is used by default. Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resumeiq
DATABASE_URL=sqlite:///./resumeiq.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional custom path if Tesseract is not installed in the standard Windows location.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
